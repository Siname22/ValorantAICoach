# ==============================================================================
# ValorantAICoach - .gitignore
# Full Stack: Python / FastAPI / Angular / Node / Docker / PostgreSQL /
#             Playwright / Ollama (IA local)
# ==============================================================================

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt
tempCodeRunnerFile.py

# Entornos virtuales
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Type checkers y linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Environment y secretos
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
secrets/
secrets.*
!secrets.toml.example
.streamlit/secrets.toml
*.pem
*.key
*.crt
credentials.json

# ------------------------------------------------------------------------------
# FastAPI / Backend
# ------------------------------------------------------------------------------
instance/
*.log
logs/
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
