{
  "name": "Valorant AI Coach Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "uv sync --all-extras",
  "postAttachCommand": {
    "backend": "uv run uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "openPreview"
    },
    "4200": {
      "label": "Frontend Web (Angular)",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    4200
  ]
}
