# ==============================================================================
# ValorantAICoach - Streamlit secrets template
# ------------------------------------------------------------------------------
# Local usage:
#   1. Copy this file to .streamlit/secrets.toml
#   2. Replace the placeholder values
#   3. Never commit .streamlit/secrets.toml (it is git-ignored)
#
# Streamlit Community Cloud usage:
#   App dashboard -> Settings -> Secrets -> paste the content below
#
# Only frontend-facing values belong here. Backend provider keys
# (RIOT_API_KEY, TRACKER_API_KEY, DATABASE_URL, ...) stay in the backend
# environment and MUST NOT be exposed to the Streamlit frontend.
# ==============================================================================

# Base URL of the FastAPI backend consumed by the Streamlit UI.
# Local backend:  "http://127.0.0.1:8000"
# Deployed cloud: "https://your-backend-domain.example.com"
VALORANT_API_BASE_URL = "http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# AI Coach chatbot (Google AI Studio / Gemini)
# ------------------------------------------------------------------------------
# Create a free key at https://aistudio.google.com/apikey
# Without this value the AI Coach page shows a setup notice and every other
# page keeps working normally.
GEMINI_API_KEY = "your_key_here"

# Gemini model tried first by the assistant. Optional: when omitted, the
# built-in default "gemini-2.5-flash" is used.
#
# If the chosen model reports itself as unavailable (HTTP 503 high demand) or
# rate limited (429), the client retries with incremental backoff and then falls
# back automatically to the next model in this chain:
#
#   1. GEMINI_MODEL (or gemini-2.5-flash by default)
#   2. gemini-2.5-flash-lite
#   3. gemini-3.5-flash
#
# Changing this value in the Streamlit Cloud secrets panel is enough to switch
# models; no code change is required.
GEMINI_MODEL = "gemini-2.5-flash"
