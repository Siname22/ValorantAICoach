APP_NAME=ValorantAICoach
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=valorant_ai_coach
POSTGRES_USER=valorant
POSTGRES_PASSWORD=valorant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://valorant:valorant@postgres:5432/valorant_ai_coach
# Enable only after running the explicit Alembic migration.
DATABASE_ENABLED=false
DATABASE_CACHE_TTL_SECONDS=300

# Riot API Configuration
RIOT_API_KEY=
RIOT_ENABLED=true
RIOT_BASE_URL=https://eu.api.riotgames.com
RIOT_ACCOUNT_BASE_URL=https://europe.api.riotgames.com
RIOT_REGION=eu
RIOT_TIMEOUT=10.0
RIOT_RETRIES=2
RIOT_MATCH_HISTORY_LIMIT=10

# HenrikDev API Configuration
HENRIK_API_KEY=
HENRIK_ENABLED=true
HENRIK_BASE_URL=https://api.henrikdev.xyz/valorant/v1
HENRIK_TIMEOUT=10.0
HENRIK_RETRIES=2
HENRIK_HEALTH_REGION=eu

# Tracker.gg API Configuration
TRACKER_API_KEY=
TRACKER_ENABLED=true
TRACKER_BASE_URL=https://public-api.tracker.gg/v2/valorant/standard
TRACKER_TIMEOUT=10.0
TRACKER_RETRIES=2

# Database Background Workers
DATABASE_AUTO_PRUNE_INTERVAL_SECONDS=0
DATABASE_AUTO_SYNC_INTERVAL_SECONDS=0

# Security & Authentication (JWT)
# In production (APP_ENV!=development), JWT_SECRET_KEY is mandatory (>= 32 chars).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAILS=

# Google Gemini API (Used by backend scoreboard vision and frontend AI Coach)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend Web Client (Angular HUD Bento SPA)
FRONTEND_PORT=8080
VALORANT_API_BASE_URL=http://127.0.0.1:8000
