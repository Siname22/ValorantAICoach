{
  "name": "valorant-ai-coach-web",
  "version": "1.0.0",
  "private": true,
  "description": "HUD Bento Angular SPA for Valorant AI Coach with strict WCAG 2.2 AA accessibility",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,css}\"",
    "api:generate": "node scripts/generate-api.mjs",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test tests/a11y.spec.ts"
  },
  "dependencies": {
    "@angular/animations": "^19.1.0",
    "@angular/cdk": "^19.1.0",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/forms": "^19.1.0",
    "@angular/platform-browser": "^19.1.0",
    "@angular/router": "^19.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.0",
    "@angular/cli": "^19.1.0",
    "@angular/compiler-cli": "^19.1.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.0",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.10.0",
    "angular-eslint": "^19.0.2",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
